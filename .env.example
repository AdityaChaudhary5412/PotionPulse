# PotionPulse Environment Variables
# Copy to .env or .env.local for development, or .env.production for production builds

# Public Backend URL (e.g. Render, Railway, or local IP when testing on mobile)
VITE_API_URL=http://localhost:8000

# When testing on Android phone via local Wi-Fi, set to your computer's LAN IP:
# VITE_API_URL=http://192.168.1.50:8000

# When deploying to production:
# VITE_API_URL=https://potionpulse-backend.onrender.com
